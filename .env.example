# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 저장소·단톡방에 올리지 않는다.

# Neo4j. 비밀번호는 8자 이상 (Docker로 처음 띄울 때 이 값으로 계정이 만들어진다)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j

# 원본 기록(시즌별 parquet) 폴더. 상대 경로는 BASEON 폴더 기준. python scripts/get_data.py 가 받는 곳
KBO_PBP_DIR=data/kbo_pbp
# Docker etl 컨테이너에 연결할 원본 폴더 (compose 파일 기준 경로). 다른 곳에 받아 뒀으면 바꾼다
KBO_PBP_HOST_DIR=./data/kbo_pbp

# API를 호출할 수 있는 화면 주소. 쉼표로 여러 개
CORS_ORIGINS=http://localhost:3000

# 06_fetch_videos.py를 돌릴 때만 필요 (Google Cloud Console에서 발급)
YOUTUBE_API_KEY=
