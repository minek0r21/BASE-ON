# 서버의 /opt/baseon/app/deploy/.env 로 복사해 값을 채운다 (scripts/deploy.py code는 이 파일을 지우지 않는다).

# Neo4j 비밀번호 (8자 이상). PC와 달라도 된다 — 덤프에는 계정이 들어가지 않는다
NEO4J_PASSWORD=

# 서버 주소. 도메인을 쓰면 Caddy가 HTTPS 인증서를 자동으로 받는다 (80 · 443이 열려 있어야 한다)
SITE_ADDRESS=
# 인증서 계정 이메일 (만료 알림). 있어야 Let's Encrypt 한도에 걸릴 때 ZeroSSL로 넘어간다
ACME_EMAIL=

# private: 아래 아이디 · 비밀번호를 물어본다 / public: 누구나
ACCESS=private
BASIC_AUTH_USER=
# 비밀번호 해시: docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext '<비밀번호>'
# $ 글자가 compose 변수로 읽히지 않게 작은따옴표로 감싼다
BASIC_AUTH_HASH=''

# 관리자 토큰 (이름:토큰). 서버에서는 Caddy가 /admin을 막지만 API에도 건다. 토큰은 아무 긴 문자열이면 된다
ADMIN_TOKENS=

# 재생 불가 신고(API-12) 판정용. 비우면 신고만 받는다
YOUTUBE_API_KEY=
