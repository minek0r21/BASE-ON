# 서버 입구. 도메인이면 HTTPS 인증서를 자동으로 받는다 (Let's Encrypt). 값은 deploy/.env
#   SITE_ADDRESS  예: baseon.duckdns.org  (로컬 시험은 :80)
#   ACCESS        private(기본, 비밀번호) | public(누구나)
#   ACME_EMAIL    인증서 계정 이메일. 있어야 Let's Encrypt가 막힐 때 ZeroSSL로 넘어간다
#                 (kro.kr처럼 여럿이 나눠 쓰는 도메인은 Let's Encrypt 주 50개 한도가 늘 차 있다 — docs/배포.md 3장)

{
	email {$ACME_EMAIL}
}

(auth_private) {
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
}
(auth_public) {
}

{$SITE_ADDRESS} {
	encode zstd gzip

	import auth_{$ACCESS}

	# 검수 화면(/admin)은 서버에서도 연다 (11-07, 팀이 같이 검수). 사이트 비밀번호 + 검수자 토큰(ADMIN_TOKENS)으로 막고,
	# 판정은 서버 장부에 남는다 → scripts/deploy.py reviews로 PC에 가져간다 (안 가져가면 db가 서버 DB를 바꾸지 않는다)
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv/www
		header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
		# 화면 미리 받기: 브라우저는 /search/__next.search.__PAGE__.txt를 찾는데 빌드는 /search/__next.search/__PAGE__.txt에 둔다.
		# 맞춰 주지 않으면 링크가 보일 때마다 404 페이지를 받는다 (휴대폰에서 특히 낭비)
		@segment path_regexp segment ^(.*)/__next\.([^/]+)\.__PAGE__\.txt$
		rewrite @segment {re.segment.1}/__next.{re.segment.2}/__PAGE__.txt
		try_files {path} {path}/index.html
		file_server
	}
	handle_errors 404 {
		root * /srv/www
		rewrite * /404.html
		file_server
	}
}
